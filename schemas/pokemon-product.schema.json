{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pokemon-product.schema.json",
  "title": "Cardlattice Pokémon product",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "pokemon-common.schema.json#/$defs/name"
    },
    "language": {
      "$ref": "pokemon-common.schema.json#/$defs/language"
    },
    "region": {
      "$ref": "pokemon-common.schema.json#/$defs/region"
    },
    "releaseDate": {
      "anyOf": [
        {
          "$ref": "pokemon-common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalIds": {
      "$ref": "pokemon-common.schema.json#/$defs/externalIds"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "relatedSets": {
      "$ref": "pokemon-common.schema.json#/$defs/references"
    }
  },
  "required": ["name"]
}
