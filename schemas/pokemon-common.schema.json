{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pokemon-common.schema.json",
  "$defs": {
    "pokemon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "pokemon-common.schema.json#/$defs/category"
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "types": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/energyType"
          }
        },
        "stage": {
          "$ref": "pokemon-common.schema.json#/$defs/stage"
        },
        "evolvesFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/attack"
          },
          "maxItems": 6,
          "uniqueItems": false,
          "minItems": 0
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/ability"
          },
          "maxItems": 6,
          "uniqueItems": false,
          "minItems": 0
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/modifier"
          },
          "maxItems": 4,
          "uniqueItems": false,
          "minItems": 0
        },
        "resistances": {
          "type": "array",
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/modifier"
          },
          "maxItems": 4,
          "uniqueItems": false,
          "minItems": 0
        },
        "retreatCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "subtypes": {
          "type": "array",
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/subtype"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "minItems": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "maxItems": 10,
          "uniqueItems": false,
          "minItems": 0
        },
        "nationalDex": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "maxItems": 6,
          "uniqueItems": true,
          "minItems": 0
        },
        "trainers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "minItems": 0
        },
        "flavourText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "species": {
          "$ref": "pokemon-common.schema.json#/$defs/name"
        },
        "heightMetres": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "weightKilograms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "enum": ["trainer", "energy"]
              }
            }
          },
          "then": {
            "properties": {
              "stage": false,
              "evolvesFrom": false,
              "weaknesses": false,
              "resistances": false,
              "retreatCost": false,
              "nationalDex": false,
              "species": false,
              "heightMetres": false,
              "weightKilograms": false,
              "level": false
            }
          }
        },
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "enum": ["trainer", "energy"]
              }
            }
          },
          "then": {
            "if": {
              "required": ["category", "hp"],
              "properties": {
                "category": {
                  "const": "trainer"
                },
                "hp": {
                  "type": "integer"
                },
                "subtypes": {
                  "type": "array",
                  "items": {
                    "const": "Item"
                  },
                  "maxItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "hp": false
              },
              "if": {
                "required": ["category", "subtypes"],
                "properties": {
                  "category": {
                    "const": "trainer"
                  },
                  "subtypes": {
                    "type": "array",
                    "contains": {
                      "const": "Pokémon Tool"
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "abilities": false
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "const": "pokemon"
              }
            }
          },
          "then": {
            "properties": {
              "subtypes": {
                "type": "array",
                "items": {
                  "enum": [
                    "ex",
                    "EX",
                    "GX",
                    "V",
                    "VMAX",
                    "VSTAR",
                    "V-UNION",
                    "BREAK",
                    "Mega",
                    "TAG TEAM",
                    "Tera",
                    "Radiant",
                    "Prism Star",
                    "Ultra Beast",
                    "Single Strike",
                    "Rapid Strike",
                    "Fusion Strike",
                    "Ancient",
                    "Future",
                    "Delta Species",
                    "LV.X",
                    "SP",
                    "LEGEND",
                    "Dynamax",
                    "Gigantamax",
                    "Eternamax",
                    "Gold Star",
                    "Shining"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "const": "trainer"
              }
            }
          },
          "then": {
            "properties": {
              "subtypes": {
                "type": "array",
                "items": {
                  "enum": [
                    "TAG TEAM",
                    "Prism Star",
                    "Single Strike",
                    "Rapid Strike",
                    "Fusion Strike",
                    "Ancient",
                    "Future",
                    "Item",
                    "Supporter",
                    "Stadium",
                    "Pokémon Tool",
                    "Pokémon Tool F",
                    "ACE SPEC"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "const": "energy"
              }
            }
          },
          "then": {
            "properties": {
              "subtypes": {
                "type": "array",
                "items": {
                  "enum": [
                    "Prism Star",
                    "Single Strike",
                    "Rapid Strike",
                    "Fusion Strike",
                    "Ancient",
                    "Future",
                    "Basic Energy",
                    "Special Energy",
                    "ACE SPEC"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "enum": ["trainer", "energy"]
              }
            }
          },
          "then": {
            "if": {
              "required": ["category", "subtypes"],
              "properties": {
                "category": {
                  "const": "trainer"
                },
                "subtypes": {
                  "type": "array",
                  "contains": {
                    "const": "Pokémon Tool"
                  }
                }
              }
            },
            "else": {
              "properties": {
                "attacks": false
              }
            }
          }
        }
      ]
    },
    "energyType": {
      "enum": [
        "Grass",
        "Fire",
        "Water",
        "Lightning",
        "Psychic",
        "Fighting",
        "Darkness",
        "Metal",
        "Colorless",
        "Dragon",
        "Fairy"
      ]
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "cost": {
          "type": "array",
          "items": {
            "$ref": "pokemon-common.schema.json#/$defs/energyType"
          },
          "maxItems": 10,
          "uniqueItems": false,
          "minItems": 0
        },
        "damage": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^(?:[0-9]+[+×-]?|\\?)$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "power": {
          "$ref": "pokemon-common.schema.json#/$defs/power"
        }
      },
      "required": ["name", "cost"]
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "kind": {
          "$ref": "pokemon-common.schema.json#/$defs/abilityKind"
        },
        "power": {
          "$ref": "pokemon-common.schema.json#/$defs/power"
        }
      },
      "required": ["name", "text", "kind"]
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "pokemon-common.schema.json#/$defs/energyType"
        },
        "value": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^[×+-][0-9]+$"
        }
      },
      "required": ["type"]
    },
    "printing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finishes": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_finishes"
        },
        "stamps": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_stamps"
        },
        "regulationMark": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_regulationMark"
        },
        "printedDenominator": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_printedDenominator"
        },
        "illustrators": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_illustrators"
        },
        "products": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_products"
        },
        "collections": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_collections"
        },
        "artwork": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_artwork"
        },
        "variants": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_variants"
        },
        "additionalNumbers": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_additionalNumbers"
        },
        "legendPart": {
          "$ref": "pokemon-common.schema.json#/$defs/printing_legendPart"
        }
      },
      "required": []
    },
    "category": {
      "enum": ["pokemon", "trainer", "energy"]
    },
    "stage": {
      "enum": [
        "Basic",
        "Stage 1",
        "Stage 2",
        "Restored",
        "BREAK",
        "MEGA",
        "VMAX",
        "VSTAR",
        "V-UNION",
        "Level-Up",
        "LEGEND"
      ]
    },
    "subtype": {
      "enum": [
        "ex",
        "EX",
        "GX",
        "V",
        "VMAX",
        "VSTAR",
        "V-UNION",
        "BREAK",
        "Mega",
        "TAG TEAM",
        "Tera",
        "Radiant",
        "Prism Star",
        "Ultra Beast",
        "Delta Species",
        "LV.X",
        "SP",
        "LEGEND",
        "Dynamax",
        "Gigantamax",
        "Eternamax",
        "Gold Star",
        "Shining",
        "Single Strike",
        "Rapid Strike",
        "Fusion Strike",
        "Ancient",
        "Future",
        "Item",
        "Supporter",
        "Stadium",
        "Pokémon Tool",
        "Pokémon Tool F",
        "ACE SPEC",
        "Basic Energy",
        "Special Energy"
      ]
    },
    "rarity": {
      "enum": [
        "C",
        "U",
        "R",
        "RR",
        "SR",
        "AR",
        "SAR",
        "RRR",
        "HR",
        "UR",
        "S",
        "SSR",
        "PR",
        "FUR",
        "A",
        "CHR",
        "CSR",
        "BWR",
        "MUR",
        "K",
        "●",
        "◆",
        "★",
        "★ (silver)",
        "★ (gold)",
        "★★",
        "★★★",
        "Common",
        "Uncommon",
        "Rare",
        "Double Rare",
        "Ultra Rare",
        "Illustration Rare",
        "Special Illustration Rare",
        "Hyper Rare",
        "Shiny Rare",
        "Shiny Ultra Rare",
        "Mega Hyper Rare",
        "Futuristic Rare",
        "Pikachu Rare",
        "ACE SPEC Rare"
      ]
    },
    "finish": {
      "enum": ["non-holo", "holo", "reverse-holo"]
    },
    "abilityKind": {
      "enum": ["Ability", "Pokémon Power", "Poké-Power", "Poké-Body", "Ancient Trait"]
    },
    "regulationMark": {
      "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "externalIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["namespace", "value"],
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        }
      },
      "maxItems": 50
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "pokemon-common.schema.json#/$defs/id"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "illustrators": {
      "type": "array",
      "items": {
        "$ref": "pokemon-common.schema.json#/$defs/name"
      },
      "maxItems": 10,
      "uniqueItems": true
    },
    "stamps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9-]+$"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "minItems": 0
    },
    "edition": {
      "enum": ["first-edition", "unlimited"]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finish": {
          "$ref": "pokemon-common.schema.json#/$defs/finish"
        },
        "edition": {
          "$ref": "pokemon-common.schema.json#/$defs/edition"
        },
        "stamps": {
          "$ref": "pokemon-common.schema.json#/$defs/stamps"
        },
        "products": {
          "$ref": "pokemon-common.schema.json#/$defs/references"
        }
      },
      "anyOf": [
        {
          "required": ["finish"],
          "properties": {
            "finish": {}
          }
        },
        {
          "required": ["edition"],
          "properties": {
            "edition": {}
          }
        },
        {
          "required": ["stamps"],
          "properties": {
            "stamps": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "required": ["products"],
          "properties": {
            "products": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "printing_finishes": {
      "type": "array",
      "items": {
        "$ref": "pokemon-common.schema.json#/$defs/finish"
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "printing_stamps": {
      "$ref": "pokemon-common.schema.json#/$defs/stamps"
    },
    "printing_regulationMark": {
      "anyOf": [
        {
          "$ref": "pokemon-common.schema.json#/$defs/regulationMark"
        },
        {
          "type": "null"
        }
      ]
    },
    "printing_printedDenominator": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        {
          "type": "null"
        }
      ]
    },
    "printing_illustrators": {
      "$ref": "pokemon-common.schema.json#/$defs/illustrators"
    },
    "printing_products": {
      "$ref": "pokemon-common.schema.json#/$defs/references"
    },
    "printing_collections": {
      "$ref": "pokemon-common.schema.json#/$defs/references"
    },
    "printing_artwork": {
      "anyOf": [
        {
          "$ref": "pokemon-common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "printing_variants": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 50,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "pokemon-common.schema.json#/$defs/variant"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "printing_additionalNumbers": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pikachu30th"],
          "properties": {
            "pikachu30th": {
              "type": "string",
              "pattern": "^(0[1-9]|[12][0-9]|30)/30$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "legendPart": {
      "enum": ["top", "bottom"]
    },
    "printing_legendPart": {
      "anyOf": [
        {
          "$ref": "pokemon-common.schema.json#/$defs/legendPart"
        },
        {
          "type": "null"
        }
      ]
    },
    "power": {
      "type": "string",
      "enum": ["VSTAR"]
    }
  }
}
