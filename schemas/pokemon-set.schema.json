{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pokemon-set.schema.json",
  "title": "Cardlattice Pokémon set",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "pokemon-common.schema.json#/$defs/name"
    },
    "language": {
      "$ref": "pokemon-common.schema.json#/$defs/language"
    },
    "region": {
      "$ref": "pokemon-common.schema.json#/$defs/region"
    },
    "releaseDate": {
      "anyOf": [
        {
          "$ref": "pokemon-common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalIds": {
      "$ref": "pokemon-common.schema.json#/$defs/externalIds"
    },
    "series": {
      "$ref": "pokemon-common.schema.json#/$defs/id"
    },
    "printedIdentifiers": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language"],
        "anyOf": [
          {
            "required": ["code"],
            "properties": {
              "code": {}
            }
          },
          {
            "required": ["symbol"],
            "properties": {
              "symbol": {}
            }
          }
        ],
        "properties": {
          "language": {
            "$ref": "pokemon-common.schema.json#/$defs/language"
          },
          "region": {
            "$ref": "pokemon-common.schema.json#/$defs/region"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[A-Za-z0-9+.\\-](?:[A-Za-z0-9 +.\\-]*[A-Za-z0-9+.\\-])?$"
          },
          "symbol": {
            "$ref": "pokemon-common.schema.json#/$defs/name"
          }
        }
      }
    },
    "finishes": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_finishes"
    },
    "stamps": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_stamps"
    },
    "regulationMark": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_regulationMark"
    },
    "printedDenominator": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_printedDenominator"
    },
    "illustrators": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_illustrators"
    },
    "products": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_products"
    },
    "collections": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_collections"
    },
    "artwork": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_artwork"
    },
    "variants": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_variants"
    },
    "additionalNumbers": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_additionalNumbers"
    },
    "legendPart": {
      "$ref": "pokemon-common.schema.json#/$defs/printing_legendPart"
    }
  },
  "required": ["name"]
}
