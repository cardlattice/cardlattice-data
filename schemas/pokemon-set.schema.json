{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cardlattice:schema:pokemon-set",
  "title": "Cardlattice Pokémon set",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "releaseDate": {
      "type": "string",
      "format": "date"
    },
    "series": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "attributes": {
      "type": "object"
    },
    "externalIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["namespace", "value"],
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "defaults": {
      "$ref": "urn:cardlattice:schema:pokemon-card#/$defs/printing"
    }
  },
  "required": ["name"]
}
