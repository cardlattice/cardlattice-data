{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cardlattice:schema:pokemon-card",
  "title": "Cardlattice Pokémon printing",
  "description": "One card printing. Game, set, language, region and default collector number come from its path. Only the name is required.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "collectorNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "rarity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "releaseDate": {
      "type": "string",
      "format": "date"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "pokemon": {
      "$ref": "#/$defs/pokemon"
    },
    "attributes": {
      "$ref": "#/$defs/pokemon"
    },
    "printingAttributes": {
      "type": "object",
      "description": "Reserved for printing-specific metadata. No fields have been defined yet.",
      "additionalProperties": false
    },
    "externalIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["namespace", "value"],
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "finishes": {
      "type": "array",
      "items": {
        "enum": ["non-holo", "holo", "reverse-holo"]
      },
      "maxItems": 3,
      "uniqueItems": true,
      "minItems": 1
    },
    "stamps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9-]+$"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "minItems": 0
    },
    "regulationMark": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "printedTotal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "illustrators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "$defs": {
    "pokemon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": ["pokemon", "trainer", "energy"]
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Grass",
              "Fire",
              "Water",
              "Lightning",
              "Psychic",
              "Fighting",
              "Darkness",
              "Metal",
              "Colorless",
              "Dragon",
              "Fairy"
            ]
          }
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "evolvesFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attack"
          },
          "maxItems": 6,
          "uniqueItems": false,
          "minItems": 0
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ability"
          },
          "maxItems": 6,
          "uniqueItems": false,
          "minItems": 0
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          },
          "maxItems": 4,
          "uniqueItems": false,
          "minItems": 0
        },
        "resistances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          },
          "maxItems": 4,
          "uniqueItems": false,
          "minItems": 0
        },
        "retreatCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "subtypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "minItems": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "maxItems": 10,
          "uniqueItems": false,
          "minItems": 0
        },
        "nationalDex": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "maxItems": 6,
          "uniqueItems": true,
          "minItems": 0
        },
        "trainers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["category"],
            "properties": {
              "category": {
                "enum": ["trainer", "energy"]
              }
            }
          },
          "then": {
            "properties": {
              "hp": false,
              "stage": false,
              "evolvesFrom": false,
              "attacks": false,
              "abilities": false,
              "weaknesses": false,
              "resistances": false,
              "retreatCost": false,
              "nationalDex": false
            }
          }
        }
      ]
    },
    "energyType": {
      "enum": [
        "Grass",
        "Fire",
        "Water",
        "Lightning",
        "Psychic",
        "Fighting",
        "Darkness",
        "Metal",
        "Colorless",
        "Dragon",
        "Fairy"
      ]
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "cost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/energyType"
          },
          "maxItems": 10,
          "uniqueItems": false,
          "minItems": 0
        },
        "damage": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[0-9]+[+×-]?$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "required": ["name", "cost"]
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "kind": {
          "enum": ["Ability", "Pokémon Power", "Poké-Power", "Poké-Body"]
        }
      },
      "required": ["name", "text", "kind"]
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/energyType"
        },
        "value": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^[×+-][0-9]+$"
        }
      },
      "required": ["type", "value"]
    },
    "printing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finishes": {
          "type": "array",
          "items": {
            "enum": ["non-holo", "holo", "reverse-holo"]
          },
          "maxItems": 3,
          "uniqueItems": true,
          "minItems": 1
        },
        "stamps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9-]+$"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "minItems": 0
        },
        "regulationMark": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "printedTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "illustrators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": []
    }
  },
  "dependentSchemas": {
    "pokemon": {
      "properties": {
        "attributes": false
      }
    },
    "identity": {
      "properties": {
        "pokemon": false,
        "attributes": false
      }
    }
  }
}
