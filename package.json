{
  "name": "@cardlattice/data",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:schema": "node scripts/validate-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives scripts",
    "format": "oxfmt --write scripts schemas package.json tsconfig.json .oxlintrc.json .oxfmtrc.json .vscode",
    "format:check": "oxfmt --check scripts schemas package.json tsconfig.json .oxlintrc.json .oxfmtrc.json .vscode",
    "check": "pnpm check:tools && pnpm validate:schema",
    "check:tools": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
